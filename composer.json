{
    "name": "funset/mfa-email",
    "type": "typo3-cms-extension",
    "description": "E-Mail MFA Provider: provides multi-factor authentication via e-mail for the TYPO3 backend.",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "typo3",
        "email",
        "mfa",
        "2fa",
        "authentication",
        "security"
    ],
    "authors": [
        {
            "name": "Ralf Freit",
            "email": "ralf@freit.de",
            "role": "Developer"
        },
        {
            "name": "Benno Nijholt",
            "email": "ik@bennonijholt.nl",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/SirFunset/mfa_email/issues",
        "source": "https://github.com/SirFunset/mfa_email"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "conflict": {
        "ralffreit/mfa-email": "*"
    },
    "autoload": {
        "psr-4": {
            "Ralffreit\\MfaEmail\\": "Classes"
        }
    },
    "replace": {
        "typo3-ter/mfa-email": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mfa_email",
            "version": "14.0.1",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "Package": {
                "providesPackages": {}
            }
        },
        "branch-alias": {
            "dev-main": "14.0.x-dev"
        }
    }
}
